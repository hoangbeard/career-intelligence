{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/doctor.py\" --session-start",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python3 scripts/doctor.py:*)",
      "Bash(python3 scripts/data_root.py:*)",
      "Bash(python3 scripts/next_job_id.py:*)",
      "Bash(python3 scripts/build_index.py:*)",
      "Bash(python3 scripts/save.py:*)",
      "Bash(python3 scripts/renumber_job.py:*)",
      "Bash(python3 scripts/init.py:*)",
      "Bash(python3 scripts/export_cv.py:*)",
      "Bash(scripts/setup-pdf.sh:*)",
      "WebFetch",
      "WebSearch"
    ]
  }
}
