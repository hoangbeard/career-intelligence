{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/doctor.mjs\" --session-start",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(node scripts/doctor.mjs:*)",
      "Bash(node scripts/data-root.mjs:*)",
      "Bash(node scripts/next-job-id.mjs:*)",
      "Bash(node scripts/build-index.mjs:*)",
      "Bash(node scripts/save.mjs:*)",
      "Bash(node scripts/renumber-job.mjs:*)",
      "Bash(node scripts/init.mjs:*)",
      "WebFetch",
      "WebSearch"
    ]
  }
}
